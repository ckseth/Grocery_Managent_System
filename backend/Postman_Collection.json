{
  "info": {
    "name": "GroceryGo REST API Backend Collection",
    "description": "Production Postman collection for testing GroceryGo Node.js/Express MERN Backend APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "Auth - Register Customer",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sarah Miller\",\n  \"email\": \"sarah.miller@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"+15552345678\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "auth", "register"]
        }
      }
    },
    {
      "name": "Auth - Login Customer",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sarah.miller@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "Products - Browse All",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/products?category=vegetables&maxPrice=15",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "products"],
          "query": [
            { "key": "category", "value": "vegetables" },
            { "key": "maxPrice", "value": "15" }
          ]
        }
      }
    },
    {
      "name": "Cart - Get Shopping Cart",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
        ],
        "url": {
          "raw": "http://localhost:5000/api/cart",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "cart"]
        }
      }
    },
    {
      "name": "Orders - Place Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shippingAddress\": {\n    \"name\": \"Sarah Miller\",\n    \"address\": \"742 Evergreen Terrace\",\n    \"city\": \"Springfield\",\n    \"state\": \"Oregon\",\n    \"zip\": \"97477\"\n  },\n  \"paymentMethod\": \"Credit Card\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/orders",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "orders"]
        }
      }
    }
  ]
}
